rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowed() {
      return request.auth != null &&
        request.auth.token.email in [
          'manulegrand33@gmail.com',
          'monikalegrand27@gmail.com'
        ];
    }
    match /{document=**} {
      allow read, write: if isAllowed();
    }
  }
}
